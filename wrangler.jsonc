{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "careerotter",
  "compatibility_date": "2026-09-24",

  // Explicit even though nodejs_compat became the default on 2026-08-04 (you now opt out
  // with no_nodejs_compat). Declaring it states the intent and survives a future default
  // change. The app needs node:crypto for AES at rest (lib/utils/encryption.ts) and Buffer
  // for hex/HMAC handling in several email and auth paths.
  "compatibility_flags": ["nodejs_compat"],

  // `main`, `assets`, `cache` and `version_metadata` below were added by
  // `vinext init --platform=cloudflare`; the bindings above them were written by hand
  // before that, and vinext merged rather than overwrote.
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": {
    // Workers Logs: 20M events/month and 7-day retention on the Paid plan, ingested from
    // plain console.log. This is what replaces Axiom — see lib/services/log-sink.ts, which
    // already emits one JSON object per line for exactly this.
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "careerotter",
      "database_id": "483ad337-4268-45ff-9285-fd4b71cfd5de",
      "migrations_dir": "./drizzle/d1"
    }
  ],

  "r2_buckets": [
    {
      // Replaces the Supabase Storage `resumes` bucket. Note the existing object keys are
      // `resumes/{uid}/{ts}-{name}` — a doubled prefix, since they were written into a
      // bucket already called `resumes`. Preserve the keys verbatim on migration so the
      // stored `user_resumes.file_url` values keep resolving.
      "binding": "RESUMES",
      "bucket_name": "careerotter-resumes"
    }
  ],

  "kv_namespaces": [
    {
      // For the caches that currently live in per-instance memory: lib/roast/cache.ts and
      // lib/utils/ai-analysis-cache.ts. Those are best-effort per-isolate today and stay
      // correct either way, so this is an improvement rather than a prerequisite.
      //
      // NOT for rate limiting. KV is eventually consistent, so a limit enforced on it can
      // be exceeded across concurrent isolates. Rate limiting needs a Durable Object, which
      // is declared once there is a class to bind.
      "binding": "CACHE",
      "id": "2513d9a93066480994abdbe23f7f8a0c"
    }
  ]

  // Cron triggers and the queue consumer are intentionally ABSENT while this is a spike.
  //
  // The generated Worker has neither a scheduled() nor a queue() handler, so declaring the
  // consumer fails the deploy outright ("Queue handler is missing", code 11001). More
  // importantly, Vercel is still running the real schedules — registering the same nine
  // crons here would mean two systems sending the same drip emails and weekly digests to
  // the same people.
  //
  // Both come back at the cron/queue stage, once a dispatcher exists. The schedules,
  // mirroring vercel.json, are:
  //   0 10  * * *  trial-notifications        0 2  * * *  sync-ai-usage
  //   0 */4 * * *  drip-emails                0 9  * * 1  generate-changelog
  //   0 14  * * *  stale-reminders            0 13 * * 1  weekly-digest
  //   0 22  * * 5  careerotter-recap          0 6  * * *  careerotter-stock-prices
  //   0 3   * * *  cleanup-expired-roasts     (was pg_cron)
}
