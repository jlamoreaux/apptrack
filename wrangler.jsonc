{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "careerotter",
  "compatibility_date": "2026-09-24",

  // Explicit even though nodejs_compat became the default on 2026-08-04 (you now opt out
  // with no_nodejs_compat). Declaring it states the intent and survives a future default
  // change. The app needs node:crypto for AES at rest (lib/utils/encryption.ts) and Buffer
  // for hex/HMAC handling in several email and auth paths.
  "compatibility_flags": ["nodejs_compat"],

  // NO `main` yet. This app still runs on Next.js/Vercel; the Worker entry point is
  // generated at the framework step (`vinext init --platform=cloudflare`, or
  // @opennextjs/cloudflare as the fallback). Declaring bindings ahead of that means the
  // resources are provisioned, named and reviewable now, and the generated entry merges
  // into this file rather than inventing its own.
  //
  // Until `main` exists, `wrangler deploy` will not work — by design. `wrangler d1`,
  // `wrangler r2`, `wrangler kv` and `wrangler queues` all work against these today.

  "observability": {
    // Workers Logs: 20M events/month and 7-day retention on the Paid plan, ingested from
    // plain console.log. This is what replaces Axiom — see lib/services/log-sink.ts, which
    // already emits one JSON object per line for exactly this.
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "careerotter",
      "database_id": "483ad337-4268-45ff-9285-fd4b71cfd5de",
      "migrations_dir": "./drizzle/d1"
    }
  ],

  "r2_buckets": [
    {
      // Replaces the Supabase Storage `resumes` bucket. Note the existing object keys are
      // `resumes/{uid}/{ts}-{name}` — a doubled prefix, since they were written into a
      // bucket already called `resumes`. Preserve the keys verbatim on migration so the
      // stored `user_resumes.file_url` values keep resolving.
      "binding": "RESUMES",
      "bucket_name": "careerotter-resumes"
    }
  ],

  "kv_namespaces": [
    {
      // For the caches that currently live in per-instance memory: lib/roast/cache.ts and
      // lib/utils/ai-analysis-cache.ts. Those are best-effort per-isolate today and stay
      // correct either way, so this is an improvement rather than a prerequisite.
      //
      // NOT for rate limiting. KV is eventually consistent, so a limit enforced on it can
      // be exceeded across concurrent isolates. Rate limiting needs a Durable Object, which
      // is declared at the framework step once there is a class to bind.
      "binding": "CACHE",
      "id": "2513d9a93066480994abdbe23f7f8a0c"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "USER_JOBS",
        "queue": "careerotter-user-jobs"
      }
    ],
    "consumers": [
      {
        // The per-user fan-out crons move here — careerotter-recap (200 users x 1 LLM call
        // sequentially), weekly-digest (LLM + email per user), stale-reminders and
        // drip-emails. The motivation is retry granularity, not CPU: today a failure at
        // user 150 silently loses the remaining 50, and MAX_USERS = 200 drops the tail
        // with no signal.
        "queue": "careerotter-user-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "careerotter-user-jobs-dlq"
      }
    ]
  },

  "triggers": {
    // Mirrors vercel.json exactly, so the schedules are reviewable side by side.
    // Cloudflare fires one `scheduled()` handler for all of them; the handler dispatches on
    // `event.cron`, which is why the strings must stay in sync with the dispatch table.
    //
    //   0 10 * * *  trial-notifications
    //   0 2  * * *  sync-ai-usage
    //   0 */4 * * * drip-emails
    //   0 9  * * 1  generate-changelog
    //   0 14 * * *  stale-reminders
    //   0 13 * * 1  weekly-digest
    //   0 22 * * 5  careerotter-recap
    //   0 6  * * *  careerotter-stock-prices
    //
    // Plus the two pg_cron jobs, which Neon/D1 cannot run and which become plain deletes:
    //   0 3  * * *  cleanup-expired-roasts
    //   0 2  * * *  cleanup-ai-preview-sessions  (folded into the 02:00 slot)
    "crons": [
      "0 10 * * *",
      "0 2 * * *",
      "0 */4 * * *",
      "0 9 * * 1",
      "0 14 * * *",
      "0 13 * * 1",
      "0 22 * * 5",
      "0 6 * * *",
      "0 3 * * *"
    ]
  }
}
