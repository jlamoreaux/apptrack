{
  "name": "apptrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:a11y": "jest --testPathPatterns=accessibility",
    "test:coverage": "jest --coverage",
    "db:schema": "echo 'DEPRECATED - see scripts/run-schema.sh header' && ./scripts/run-schema.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "./scripts/ci/typecheck-ratchet.sh",
    "db:truth": "./scripts/migration/dump-prod-truth.sh",
