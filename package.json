    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:verify": "./scripts/migration/verify-baseline.sh",
    "db:drift": "./scripts/ci/schema-drift-guard.sh",
    "gen:content": "node scripts/build/gen-content.mjs",
    "prebuild": "node scripts/build/gen-content.mjs",
    "scan:tenant-scoping": "node scripts/ci/scan-tenant-scoping.js",
    "db:parity": "node scripts/migration/verify-drizzle-parity.mjs"
